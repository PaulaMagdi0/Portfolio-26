# Public site URL — used by SEO metadata, canonical/hreflang tags, sitemap,
# robots, and absolute OG-image URLs. Set this to the canonical custom domain
# (no trailing slash). If unset, the code falls back to https://paulamagdy.com.
# Set this in Vercel → Project → Settings → Environment Variables (Production).
NEXT_PUBLIC_SITE_URL=https://paulamagdy.com

# Web3Forms access key for the contact form.
# Generate one for free at https://web3forms.com/ by entering the inbox that
# should receive form submissions. Required for the contact form to deliver
# messages; without it the form shows an error banner on submit.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=__YOUR_KEY_HERE__
